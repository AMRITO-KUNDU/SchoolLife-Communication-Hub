# ─── Frontend (Vercel) ────────────────────────────────────────────────────────
# URL of the Render API. Must NOT have a trailing slash.
# When empty the frontend uses relative /api/... paths (works with local proxy
# or Vercel rewrite rules).
VITE_API_URL=https://schoollife-communication-hub.onrender.com

# Clerk publishable key (safe to expose – it is embedded in the JS bundle).
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ─── Backend (Render) ─────────────────────────────────────────────────────────
# Allowed cross-origin for CORS. Set to your Vercel URL – no trailing slash.
APP_ORIGIN=https://school-life-communication-hub.vercel.app

# Redirect target after Google OAuth callback.
FRONTEND_URL=https://school-life-communication-hub.vercel.app

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clerk secret key  (NEVER put in a VITE_ variable)
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://schoollife-communication-hub.onrender.com/api/google/callback

# Groq AI
GROQ_API_KEY=gsk_...
