# ─── Master Environment Example ───────────────────────────────────────────────
# For individual app and package configurations, refer to:
# - apps/web/.env.example
# - apps/api/.env.example
# - packages/db/.env.example

# ─── Frontend Configuration (Vercel / web) ───────────────────────────────────
# Backend API URL (no trailing slash). Leave blank for same-origin local proxy.
VITE_API_URL=https://schoollife-communication-hub.onrender.com

# Clerk Publishable Key (embedded in client build)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# ─── Backend Configuration (Render / api) ─────────────────────────────────────
# Allowed Origin for CORS (no trailing slash)
APP_ORIGIN=https://school-life-communication-hub.vercel.app

# Frontend redirect target for OAuth completion
FRONTEND_URL=https://school-life-communication-hub.vercel.app

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Clerk Authentication Secrets
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# Google OAuth Client Credentials & Redirect Callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://schoollife-communication-hub.onrender.com/api/google/callback

# Groq AI Service Configuration
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant
