# API Base URL for Express Backend
# Set to full backend URL in production (e.g. https://schoollife-communication-hub.onrender.com)
# Leave empty or set to http://localhost:5000 for local development proxy / rewrites
VITE_API_URL=http://localhost:5000

# Clerk Authentication Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional Clerk Proxy URL
# VITE_CLERK_PROXY_URL=

# Optional Local Dev Server Settings
# PORT=5173
# BASE_PATH=/
# VITE_API_PROXY=http://localhost:5000
